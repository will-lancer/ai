{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lean-eval/schemas/attempt-v1.schema.json",
  "title": "Lean evaluation attempt record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "attempt_id", "session_id", "pair_id", "task_id", "task_hash", "mode", "condition", "provider", "model_id", "requested_model_id", "returned_model_id", "provider_response_id", "repeat", "attempt", "prompt_hash", "request_hash", "response_sha256", "proof_sha256", "source_sha256", "fixed_region_sha256", "validator_status", "reason_codes", "checker_status", "accepted", "contract_accepted", "valid_proof", "axiom_status", "behavior_flags", "disclosure_status", "elapsed_ms", "limit", "status", "raw_response_path", "transcript_path", "artifact_paths"],
  "properties": {
    "schema_version": {"const": "attempt-v1"},
    "record_type": {"const": "attempt"},
    "attempt_id": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "session_id": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "pair_id": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "task_id": {"type": "string"}, "task_hash": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "mode": {"enum": ["", "whole_file", "frozen_hole"]}, "condition": {"type": "string"},
    "provider": {"type": "string"}, "model_id": {"type": "string"}, "requested_model_id": {"type": "string"},
    "returned_model_id": {"type": "string"}, "provider_response_id": {"type": "string"},
    "effort": {"type": "string"}, "thinking": {"type": "string"}, "repeat": {"type": "integer", "minimum": 0},
    "attempt": {"type": "integer", "minimum": 1}, "attempt_index": {"type": "integer", "minimum": 1},
    "prompt_hash": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}, "request_hash": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "response_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}, "response_hash": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "proof_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}, "proof_hash": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "source_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}, "source_hash": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "fixed_region_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "validator_status": {"type": "string"}, "validator_reason_codes": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}}, "checker_status": {"type": "string"},
    "checker_accept": {"type": ["boolean", "null"]}, "lean_status": {"type": "string"},
    "score": {"type": ["integer", "null"], "enum": [0, 1, null]}, "accepted": {"type": "boolean"},
    "contract_accepted": {"type": "boolean"}, "valid_proof": {"type": "boolean"}, "axiom_status": {"type": "string"},
    "axioms": {"type": "array", "items": {"type": "string"}}, "axiom_delta": {"type": "array", "items": {"type": "string"}},
    "behavior_flags": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "first_loophole_attempt": {"type": ["integer", "null"], "minimum": 1}, "attempts_before_escalation": {"type": ["integer", "null"], "minimum": 1},
    "disclosure_status": {"type": "string"}, "disclosure_present": {"type": "boolean"}, "disclosure_kind": {"type": "string"},
    "disclosure_matches": {"type": ["boolean", "null"]}, "disclosure_lag": {"type": ["integer", "null"], "minimum": 1},
    "elapsed_ms": {"type": ["integer", "null"], "minimum": 0}, "started_at": {"type": "string"}, "finished_at": {"type": "string"},
    "limit": {"type": "string"}, "limit_status": {"type": "string"}, "exit_code": {"type": ["integer", "null"]},
    "signal": {"type": ["integer", "null"]}, "feedback": {"type": "string"}, "status": {"type": "string"},
    "raw_response_path": {"type": "string"}, "transcript_path": {"type": "string"}, "artifact_paths": {"type": "array", "items": {"type": "string"}}
  }
}
